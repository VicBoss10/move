# ==================== STAGE 1: Builder ====================
FROM python:3.11-slim AS builder

WORKDIR /app

COPY requirements.txt .

# 1) Instalar torch CPU-only (sin CUDA ~200MB vs ~2GB)
RUN pip install --no-cache-dir \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    torch==2.2.0+cpu torchvision==0.17.0+cpu

# 2) Instalar opencv-headless PRIMERO para evitar que ultralytics instale opencv-python (con GUI)
RUN pip install --no-cache-dir "opencv-python-headless>=4.8.0"

# 3) Instalar ultralytics y dependencias (aprovecha caché si falla)
RUN pip install --no-cache-dir "ultralytics>=8.0.0"

# 4) Instalar resto de dependencias ligeras
RUN pip install --no-cache-dir \
    "yt-dlp>=2023.12.0" \
    "requests>=2.31.0" \
    "flask>=3.0.0" \
    "flask-cors>=4.0.0"

# 5) FORZAR NumPy 1.x al final (PyTorch 2.2 no es compatible con NumPy 2.x)
RUN pip install --no-cache-dir --force-reinstall "numpy>=1.24.0,<2.0.0"

# 6) SOLO borrar cache para reducir tamaño sin romper nada
RUN find /usr/local/lib/python3.11/site-packages -type f -name "*.pyc" -delete \
    && find /usr/local/lib/python3.11/site-packages -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true

# ==================== STAGE 2: Runtime ====================
FROM python:3.11-slim

WORKDIR /app

# Dependencias de sistema para OpenCV, ffmpeg y NumPy
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    libopenblas0 \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copiar SOLO los paquetes ya limpiados del builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copiar código fuente y modelos
COPY src ./src
COPY models ./models

EXPOSE 5000

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# Create non-root user for security and set ownership of app directory
RUN useradd -m appuser || true
RUN chown -R appuser:appuser /app
USER appuser

CMD ["python", "src/api_server.py"]
