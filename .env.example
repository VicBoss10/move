# ============================================================
# MOVE - Variables de entorno
# Copia este archivo: cp .env.example .env
# Rellena los valores reales en .env.
# NUNCA hagas commit del .env (ya está en .gitignore).
# ============================================================


# ── Frontend ─────────────────────────────────────────────────
# API Key de Google Maps (solo requerida en Docker/producción).
# Para desarrollo con ng serve, usa frontend/src/assets/config.json
# (cópiala de frontend/src/assets/config.json.example).
GOOGLE_MAPS_API_KEY=


# ── Base de datos principal (move_db) ────────────────────────
POSTGRES_PASSWORD=postgres


# ── Keycloak: base de datos ──────────────────────────────────
KEYCLOAK_DB_PASSWORD=keycloak123


# ── Keycloak: admin ──────────────────────────────────────────
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin123


# ── Keycloak: URL pública ────────────────────────────────────
# Debe coincidir con el claim 'iss' del JWT que genera Keycloak.
# En producción cambia esto por la URL real (ej: https://auth.tudominio.com/realms/move).
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/move


# ── pgAdmin ──────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123


# ── Servicio de detección de vehículos ───────────────────────
# URL del backend accesible desde el contenedor de detección.
# En Docker usa la red interna. Cambiar solo si corres el servicio fuera de Docker.
BACKEND_URL=http://backend:8080

# Keycloak token endpoint for service clients (used by vehicle detection service)
# Use public host URL so the service obtains a token with the same `iss` as used by
# Postman/host requests. On Linux this resolves via host.docker.internal mapping.
KEYCLOAK_TOKEN_URL=http://host.docker.internal:8081/realms/move/protocol/openid-connect/token

# Credenciales del cliente confidencial para que el servicio de detección
# pueda obtener tokens vía client_credentials (rellena con valores reales)
VEHICLE_CLIENT_ID=move-backend
VEHICLE_CLIENT_SECRET=your_vehicle_client_secret

# Forzar Host header en peticiones al endpoint de token desde el contenedor
# (opcional) — por ejemplo: localhost:8081
KEYCLOAK_TOKEN_HOST=localhost:8081
