# ============================================================
# MOVE - Variables de entorno
# Copia este archivo: cp .env.example .env
# Rellena los valores reales en .env.
# NUNCA hagas commit del .env (ya está en .gitignore).
# ============================================================


# ── Secrets / contraseñas ─────────────────────────────────────
POSTGRES_PASSWORD=postgres
KEYCLOAK_DB_PASSWORD=keycloak123
KEYCLOAK_ADMIN_PASSWORD=admin123
PROVISIONING_FACTORY_TOKEN=


# ── Keycloak (público) ───────────────────────────────────────
# KEYCLOAK_ISSUER_URI: URL pública que Keycloak pone en el claim 'iss' de los JWTs.
#   En desarrollo local: http://localhost:8081/realms/move
#   En producción:       https://auth.tudominio.com/realms/move
# KEYCLOAK_PUBLIC_HOSTNAME: hostname del contenedor Keycloak (sin https://).
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/move
KEYCLOAK_PUBLIC_HOSTNAME=localhost


# ── URLs internas entre servicios Docker ─────────────────────
# Defaults = red interna Docker (todo en el mismo servidor).
# Cambiar SOLO si separas servicios en distintos servidores.
# Ejemplo separado: KEYCLOAK_JWK_SET_URI=https://auth.tudominio.com/realms/move/protocol/openid-connect/certs
#KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/move/protocol/openid-connect/certs
#KEYCLOAK_SERVER_URL=http://keycloak:8080
#KEYCLOAK_REALM=move
#PYTHON_SERVICE_URL=http://vehicle-detection:5000
#BACKEND_URL=http://backend:8080
#KEYCLOAK_TOKEN_URL=http://keycloak:8080/realms/move/protocol/openid-connect/token
#SPRING_DATASOURCE_URL=jdbc:postgresql://move_db:5432/move_db


# ── URLs públicas del sistema ─────────────────────────────────
# Usadas por el frontend (Docker) y el backend (CORS).
# En desarrollo local los defaults del código ya apuntan a localhost.
FRONTEND_API_BASE_URL=https://api.tudominio.com
FRONTEND_AUTH_BASE_URL=https://auth.tudominio.com
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost,http://localhost:80,https://tudominio.com


# ── Frontend ─────────────────────────────────────────────────
# API Key de Google Maps (solo requerida en Docker/producción).
# Para desarrollo con ng serve, usa frontend/src/assets/config.json.
GOOGLE_MAPS_API_KEY=


# ── Servicio de detección de vehículos ───────────────────────
# Credenciales del cliente confidencial para obtener tokens vía client_credentials.
VEHICLE_CLIENT_ID=move-backend
VEHICLE_CLIENT_SECRET=your_vehicle_client_secret


# ── pgAdmin ──────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123
