# ============================================================
# MOVE - Plantilla de Variables de Entorno
# ============================================================
# INSTRUCCIONES:
# 1. Copia este archivo: cp .env.example .env
# 2. Elige un modo (Local o Internet) y rellena los valores.
# 3. NUNCA hagas commit del archivo .env real.
# ============================================================

# ── 1. SEGURIDAD Y CREDENCIALES (Globales) ──────────────────
# Estos valores deben definirse siempre.
POSTGRES_PASSWORD=postgres
KEYCLOAK_DB_PASSWORD=keycloak123
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin123
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123
# Token para el registro automático de nuevos dispositivos IoT
PROVISIONING_FACTORY_TOKEN=
# Credenciales para el microservicio de detección de IA
VEHICLE_CLIENT_ID=move-backend
VEHICLE_CLIENT_SECRET=your_vehicle_client_secret
# Clave de Google Maps para el mapa de estaciones
GOOGLE_MAPS_API_KEY=

# ── 2. CONFIGURACIÓN PARA DESARROLLO LOCAL ──────────────────
# Descomenta estas líneas para trabajar en localhost (http://localhost)
# ────────────────────────────────────────────────────────────
# KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/move
# KEYCLOAK_PUBLIC_HOSTNAME=localhost
# FRONTEND_API_BASE_URL=http://localhost:8080
# FRONTEND_AUTH_BASE_URL=http://localhost:8081
# CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80,http://localhost
# PYTHON_SERVICE_URL=http://host.docker.internal:5000

# ── 3. CONFIGURACIÓN PARA EXPOSICIÓN A INTERNET ─────────────
# Descomenta estas líneas para producción/túneles (https://tudominio.com)
#  IMPORTANTE: No mezcles estas variables con las de desarrollo local.
# ────────────────────────────────────────────────────────────
# KEYCLOAK_ISSUER_URI=https://auth.tudominio.com/realms/move
# KEYCLOAK_PUBLIC_HOSTNAME=auth.tudominio.com
# FRONTEND_API_BASE_URL=https://api.tudominio.com
# FRONTEND_AUTH_BASE_URL=https://auth.tudominio.com
# CORS_ALLOWED_ORIGINS=https://tudominio.com
# PYTHON_SERVICE_URL=https://tudominio.com/api/v1/detection
# PYTHON_SERVICE_PUBLIC_URL=https://tudominio.com
