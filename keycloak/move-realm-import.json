      "credentials": [
        {
          "type": "password",
          "value": "demo123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-move",
        "user"
      ]
    }
  ],
  "defaultRoles": [
    "offline_access",
    "uma_authorization",
    "default-roles-move"
  ]
}
